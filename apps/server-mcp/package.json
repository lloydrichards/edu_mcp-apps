{
  "name": "server-mcp",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun --minify --external:msgpackr --external:msgpackr-extract",
    "build:types": "tsc --emitDeclarationOnly",
    "dev": "bun --watch run src/index.ts",
    "inspector": "bunx @mcpjam/inspector@latest",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.2",
    "@repo/lit-lab": "workspace:*",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@effect/language-service": "^0.83.1",
    "@effect/vitest": "4.0.2",
    "@repo/config-typescript": "workspace:*",
    "@types/bun": "1.3.11",
    "vitest": "^5.0.3"
  }
}
