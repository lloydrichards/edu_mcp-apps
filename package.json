{
  "name": "edu-mcp-apps",
  "description": "MCP Apps exploration with Effect v4 and Lit",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "dev": "bun run build && turbo run dev --filter=server-mcp",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "type-check": "turbo run type-check",
    "start": "bun run apps/server-mcp/dist/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.11",
    "turbo": "^2.8.20",
    "typescript": "6.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
